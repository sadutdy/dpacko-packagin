---
import EnquiryForm from '../components/EnquiryForm';
import Reveal from '../components/Reveal';
import { PRODUCTS } from '../data/products';
import { SITE, waLink } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Search-based embed (no API key). Replace with the exact pin once the Google Business Profile exists.
const mapQuery = 'D PACKO Packaging Solutions, Melmuri, Calicut Road, Malappuram, Kerala 676517';
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent('Melmuri, Malappuram, Kerala 676517')}&z=15&output=embed`;
const mapOpen = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const mapDirections = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;

const channels = [
  ['📞', 'Call us', SITE.phoneDisplay, `tel:${SITE.phoneTel}`, 'Best for quick questions'],
  ['💬', 'WhatsApp', 'Chat with us', waLink("Hi D PACKO, I'd like to know more about your boxes."), 'Share product, size and quantity'],
  ['📸', 'Instagram', '@dpack_o', SITE.instagram, 'See our latest boxes'],
] as const;

const reasons = [
  ['Get a wholesale or retail quote', 'Tell us the box, size and quantity.'],
  ['Ask about custom printing', 'Share your logo and we will advise on options.'],
  ['Check stock and delivery', 'Confirm availability and delivery time for your district.'],
  ['Arrange a pickup', 'Collect your order from Melmuri, Malappuram.'],
] as const;

const faqs = [
  ['How quickly will you reply?', 'WhatsApp is the fastest way to reach us. We reply to enquiries as soon as we can during working hours.'],
  ['Can I visit your shop?', `Yes — we are at ${SITE.address.join(', ')}. Please call or message before visiting so your order is ready.`],
  ['What should I include in my enquiry?', 'The box type, size, quantity, whether you want printing, and your district for delivery.'],
] as const;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout
  title="Contact D PACKO Packaging Solutions | Melmuri, Malappuram, Kerala"
  description="Call or WhatsApp D PACKO at +91 98469 94836. Visit us at 29/229 Melmuri, Calicut Road, Malappuram, Kerala 676517. Get directions on Google Maps."
  jsonLd={[faqLd]}
>
  <section class="bg-gradient-to-b from-brand-50 to-paper">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <Reveal client:load>
        <h1 class="text-4xl font-extrabold">Contact D PACKO</h1>
        <p class="mt-3 max-w-2xl text-lg text-stone-600">
          Wholesale or retail, printed or plain — tell us what you need and we will get back to you
          with rates and delivery time.
        </p>
      </Reveal>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {channels.map(([icon, title, value, href, note], i) => (
          <Reveal client:load delay={i * 0.08}>
            <a href={href} class="block h-full rounded-2xl border border-stone-200 bg-white p-5 transition hover:-translate-y-1 hover:shadow-md" rel="noopener">
              <div class="text-3xl" aria-hidden="true">{icon}</div>
              <h2 class="mt-3 font-bold">{title}</h2>
              <p class="font-semibold text-brand-700">{value}</p>
              <p class="mt-1 text-sm text-stone-600">{note}</p>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-extrabold">Send an enquiry</h2>
      <p class="mt-2 mb-6 text-stone-600">Fill this in and it opens WhatsApp with your details ready to send.</p>
      <EnquiryForm client:load whatsapp={SITE.whatsapp} products={PRODUCTS.map((p) => p.name)} />
    </div>
    <div>
      <h2 class="text-3xl font-extrabold">What to contact us about</h2>
      <ul class="mt-6 space-y-4">
        {reasons.map(([t, d]) => (
          <li class="flex gap-3">
            <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm text-white">✓</span>
            <span><span class="font-semibold">{t}.</span> <span class="text-stone-600">{d}</span></span>
          </li>
        ))}
      </ul>
      <address class="mt-8 rounded-2xl border border-stone-200 bg-white p-5 not-italic">
        <p class="font-bold">{SITE.name}</p>
        {SITE.address.map((l) => <p class="text-stone-600">{l}</p>)}
        <p class="mt-2 text-sm text-stone-500">GSTIN {SITE.gstin}</p>
      </address>
    </div>
  </section>

  <section class="bg-stone-900 py-14 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Reveal client:load>
        <h2 class="text-3xl font-extrabold">Find us on Google Maps</h2>
        <p class="mt-2 text-stone-300">{SITE.address.join(', ')}</p>
      </Reveal>
      <div class="mt-6 overflow-hidden rounded-2xl border border-stone-700">
        <iframe
          title="D PACKO Packaging Solutions on Google Maps"
          src={mapEmbed}
          width="100%"
          height="420"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={mapDirections} rel="noopener" class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white">Get directions</a>
        <a href={mapOpen} rel="noopener" class="rounded-full border border-stone-500 px-6 py-3 font-semibold">Open in Google Maps</a>
      </div>
      <p class="mt-4 text-sm text-stone-400">Please call or message before visiting so your order is ready.</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h2 class="text-3xl font-extrabold">Before you contact us</h2>
    <div class="mt-6 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
      {faqs.map(([q, a]) => (
        <details class="p-5">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">{q}</summary>
          <p class="mt-2 text-stone-600">{a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
