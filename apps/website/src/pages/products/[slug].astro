---
import Reveal from '../../components/Reveal';
import { PRODUCTS } from '../../data/products';
import { waLink } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---
<BaseLayout
  title={`${product.name} Wholesale in Malappuram, Kerala | D PACKO`}
  description={`${product.tagline}. ${product.moq}.`}
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <a href="/products" class="text-sm font-semibold text-brand-700">← All products</a>
    <h1 class="mt-3 text-4xl font-extrabold">{product.name}</h1>
    <p class="mt-3 text-lg text-stone-600">{product.description}</p>
    {product.image && (
      <img
        src={product.image.src}
        alt={product.image.alt}
        width={product.image.width}
        height={product.image.height}
        class="mt-8 max-h-[32rem] w-full rounded-2xl object-contain bg-white"
      />
    )}

    <Reveal client:load>
      <h2 class="mt-10 text-xl font-bold">Sizes</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {product.variants.map((v) => (
          <li class="rounded-xl border border-stone-200 bg-white p-4">
            <span class="font-semibold">{v.name}</span> <span class="text-stone-500">— {v.detail}</span>
          </li>
        ))}
      </ul>
    </Reveal>

    <Reveal client:load delay={0.1}>
      <h2 class="mt-10 text-xl font-bold">Pack sizes</h2>
      <p class="mt-2">{product.packSizes.join(' · ')}</p>
      <p class="mt-2 text-stone-600">{product.moq}</p>
      <a
        href={waLink(`Hi D PACKO, please share the price for ${product.name}.`)}
        class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-3 font-semibold text-white"
      >
        Ask price on WhatsApp
      </a>
    </Reveal>
  </section>
</BaseLayout>
