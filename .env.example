# ---- App ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5175

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017/ameen?replicaSet=rs0
MONGO_DB_NAME=ameen

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_PRIVATE_KEY=replace-with-a-generated-rsa-private-key
JWT_PUBLIC_KEY=replace-with-a-generated-rsa-public-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECRET=replace-with-a-long-random-string
BCRYPT_PEPPER=replace-with-a-long-random-string

# ---- Object storage (MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ameen
S3_ACCESS_KEY=ameen
S3_SECRET_KEY=ameen-secret
S3_FORCE_PATH_STYLE=true

# ---- Third-party (stubs in dev) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
SMS_PROVIDER_URL=
SMS_TOKEN=

# ---- Feature flags ----
ENABLE_OTP_AUTOLOGIN=false
LOG_LEVEL=info
